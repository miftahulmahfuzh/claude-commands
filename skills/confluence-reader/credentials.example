# confluence-reader credentials
# Copy this file to ~/.config/confluence-reader/credentials and fill it in.
#   mkdir -p ~/.config/confluence-reader
#   cp credentials.example ~/.config/confluence-reader/credentials
#   chmod 600 ~/.config/confluence-reader/credentials
# NEVER commit a filled-in copy. Do not paste your password into a chat.

CONFLUENCE_BASE_URL=https://wiki.example.com

# --- Option A (preferred): Personal Access Token ---
# Profile > Settings > Personal Access Tokens > Create token.
# Scoped, revocable, no password stored.
CONFLUENCE_PAT=

# --- Option B: username + password/API token (fallback) ---
# Leave blank if using a PAT above.
CONFLUENCE_USER=
CONFLUENCE_PASS=
# On Confluence Cloud, use an API token here instead of a password:
CONFLUENCE_API_TOKEN=
