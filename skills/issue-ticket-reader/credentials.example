# issue-ticket-reader (Jira) credentials
#
# OPTIONAL: if ~/.config/confluence-reader/credentials already exists, this skill reuses
# those credentials automatically (Jira and Confluence share one user directory). You only
# need this file when Jira uses a DIFFERENT login, or when you want a Jira-specific PAT.
#
#   mkdir -p ~/.config/issue-ticket-reader
#   cp credentials.example ~/.config/issue-ticket-reader/credentials
#   chmod 600 ~/.config/issue-ticket-reader/credentials
#
# NEVER commit a filled-in copy. Do not paste your password into a chat.

# Jira base URL — only needed if you pass a bare issue key (ABC-123) instead of a full URL.
JIRA_BASE_URL=https://project.example.com

# --- Option A (preferred): Personal Access Token ---
# Jira Server/DC >= 8.14: Profile > Personal Access Tokens > Create token.
# Scoped, revocable, no password stored.
JIRA_PAT=

# --- Option B: username + password/API token (fallback) ---
# Leave blank if using a PAT above.
JIRA_USER=
JIRA_PASS=
# On Jira Cloud, use an API token here instead of a password (id.atlassian.com > Security):
JIRA_API_TOKEN=
